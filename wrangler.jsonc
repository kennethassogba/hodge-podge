{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hodge-podge",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "hodge-podge", "database_id": "788c6885-124f-4da7-a724-6ea4cf2335b5", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": {
    "TEXT_MODEL": "gpt-4.1-mini",
    "VOICE_MODEL": "gpt-realtime-2.1"
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
