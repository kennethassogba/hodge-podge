{
  "name": "hodge-podge",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "test": "node --test tests/*.test.js",
    "check": "tsc --noEmit",
    "types": "wrangler types",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "miniflare": "^5.20260925.0-alpha",
    "typescript": "^7.0.2",
    "wrangler": "^4.141.0"
  }
}
